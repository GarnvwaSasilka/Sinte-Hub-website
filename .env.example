# ---------------------------------------------------------------------
# Sinte's Hub settings. Copy this file to ".env.local" for your computer,
# and add the same names in Netlify (Site configuration → Environment
# variables). NEVER commit .env.local to GitHub.
# ---------------------------------------------------------------------

# --- Needed by the website (safe to be public) -----------------------
# Supabase → Project Settings → API (or "Connect") → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Supabase → Project Settings → API Keys → "anon public" key
# (newer projects call it the "publishable" key; either works here)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# The full web address of your shop, without a slash at the end
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# --- Only for the backup / restore scripts on YOUR computer -----------
# Do NOT add these to Netlify. They give full access to your database.
# Supabase → "Connect" button → "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Only needed when restoring PHOTOS: Supabase → Project Settings → API Keys
# → "service_role" (or "secret") key.
SUPABASE_SERVICE_ROLE_KEY=
